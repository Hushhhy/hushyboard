// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // Explicit .ts imports so Node can run scripts that use the client (prisma/seed.ts) without a build step.
  importFileExtension = "ts"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Career domain
  resumes       Resume[]
  applications  Application[]
  jobOffers     JobOffer[]
  watchSources  WatchSource[]
  watchKeywords WatchKeyword[]

  // Mail (Gmail connection, phase 5)
  gmailConnection  GmailConnection?
  mailMatches      MailMatch[]
  mailUnsubscribes MailUnsubscribe[]
  jobAlertSettings JobAlertSettings?
  jobAlertMails    JobAlertMail[]
  certifications   Certification[]
  courses          Course[]
  xpEvents         XpEvent[]

  // Habits & goals domain
  habits      Habit[]
  habitPauses HabitPause[]
  goals       Goal[]

  // Leisure domain
  games Game[]

  // Finance domain
  financeCategories FinanceCategory[]
  transactions      Transaction[]
  csvImports        CsvImport[]

  // Trophies (every domain, no XP)
  trophies TrophyUnlock[]

  // Profile and skills
  skills          Skill[]
  tools           Tool[]
  profileInfo     ProfileInfo?
  timelineEntries TimelineEntry[]

  // AI usage log (free-tier quota follow-up)
  aiUsage AiUsage[]

  // GitHub projects
  projects Project[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// =============================================================================
// CAREER DOMAIN
// The only domain that earns XP. Levels are not stored: they are computed from
// the sum of XpEvent.amount (see lib/xp.ts).
// =============================================================================

enum ApplicationStatus {
  SENT
  WAITING
  HR_INTERVIEW
  TECH_INTERVIEW
  OFFER
  REJECTED
  NO_RESPONSE
  FOLLOWED_UP // « Relancée »
}

enum ApplicationKind {
  OFFER
  SPONTANEOUS
}

enum ContractType {
  INTERNSHIP
  APPRENTICESHIP
  PERMANENT
  FIXED_TERM
  VIE
  FREELANCE
  OTHER
}

enum OfferDecision {
  PENDING
  APPLIED
  DISMISSED
}

enum CourseStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum CertificationStatus {
  PLANNED
  IN_PROGRESS
  OBTAINED
}

enum XpReason {
  APPLICATION_SENT
  HR_INTERVIEW
  TECH_INTERVIEW
  COURSE_COMPLETED
  CERTIFICATION_OBTAINED
  OFFER_RECEIVED
  QUIZ_PASSED // score >= 70 %
  SOLO_PROJECT_COMPLETED
}

/// A version of the CV (e.g. "Data Engineer, FR"). The PDF itself is stored later (phase 3).
model Resume {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  language     String        @default("fr")
  fileUrl      String? // unused: original PDFs are never stored
  content      Json? // ResumeContent, validated by lib/resume/schema.ts
  isDefault    Boolean       @default(false)
  // An adapted version derives from a base CV and belongs to one offer.
  basedOnId    String?
  basedOn      Resume?       @relation("ResumeAdaptations", fields: [basedOnId], references: [id], onDelete: SetNull)
  adaptations  Resume[]      @relation("ResumeAdaptations")
  jobOfferId   String?       @unique
  jobOffer     JobOffer?     @relation("AdaptedResume", fields: [jobOfferId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@index([userId])
  @@map("resumes")
}

/// A job offer spotted during the watch ("Veille" tab), before deciding to apply or not.
model JobOffer {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  company       String
  location      String?
  contractType  ContractType?
  source        String?
  url           String?
  tags          String[]
  foundAt       DateTime      @default(now())
  decision      OfferDecision @default(PENDING)
  decidedAt     DateTime?
  // Set when the offer came from a job-alert mail (« Veille automatique »).
  importedAt    DateTime?
  description   String? // pasted offer text, needed for the analysis
  summary       String?
  remotePolicy  String?
  // { score, strengths[], gaps[], changes[], baseResumeId, model }
  analysis      Json?
  analyzedAt    DateTime?
  application   Application?
  adaptedResume Resume?       @relation("AdaptedResume")
  coverLetter   CoverLetter?

  @@index([userId, decision])
  @@map("job_offers")
}

/// An application sent to a company. Its current status is copied here for fast filtering;
/// the full history lives in ApplicationEvent.
model Application {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ApplicationKind    @default(OFFER)
  company      String
  position     String? // a spontaneous application may have none
  careersUrl   String? // spontaneous: the company's careers page
  contractType ContractType?
  location     String?
  source       String?
  url          String?
  status       ApplicationStatus  @default(SENT)
  sentAt       DateTime           @default(now())
  followUpAt   DateTime?
  notes        String?
  resumeId     String?
  resume       Resume?            @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobOfferId   String?            @unique
  jobOffer     JobOffer?          @relation(fields: [jobOfferId], references: [id], onDelete: SetNull)
  events       ApplicationEvent[]
  mailMatches  MailMatch[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, sentAt])
  @@map("applications")
}

/// One step in an application's history ("sent on 15/10", "HR interview on 22/10").
model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  occurredAt    DateTime          @default(now())
  note          String?

  @@index([applicationId, occurredAt])
  @@map("application_events")
}

/// A certification, obtained or targeted (e.g. "IBM Data Engineering").
model Certification {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  issuer        String
  status        CertificationStatus @default(PLANNED)
  totalCourses  Int?
  plannedFor    DateTime?
  obtainedAt    DateTime?
  credentialUrl String?
  // Picture of the certificate or badge: read from the credential page (og:image) or pasted by Alex.
  imageUrl      String?
  costCents     Int?
  courses       Course[]
  skills        Skill[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, status])
  @@map("certifications")
}

/// A course, standalone or part of a certification path ("course 4 of 13").
model Course {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  provider        String
  status          CourseStatus   @default(PLANNED)
  progress        Int            @default(0) // legacy manual %, no longer used: progress is computed from items
  position        Int? // order inside the certification path
  certificationId String?
  certification   Certification? @relation(fields: [certificationId], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  completedAt     DateTime?
  nextDeadline    DateTime?
  notes           CourseNote[]
  modules         CourseModule[]
  skills          Skill[]
  projects        Project[] // GitHub repos done for this course (solo projects, exercises)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@map("courses")
}

model CourseNote {
  id        String      @id @default(cuid())
  courseId  String
  course    Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The part, quiz or solo project the note is about; null = general note of the course.
  itemId    String?
  item      CourseItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  title     String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([courseId])
  @@map("course_notes")
}

/// A module of a course ("Module 2 · SQL"), ordered inside the course.
model CourseModule {
  id       String       @id @default(cuid())
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  position Int          @default(0)
  items    CourseItem[]

  @@index([courseId, position])
  @@map("course_modules")
}

enum CourseItemKind {
  PART
  QUIZ
  SOLO_PROJECT
}

/// One thing to do inside a module: a part (lesson), a quiz or a solo project.
/// The course progress is computed from these (done / total), never stored.
model CourseItem {
  id          String         @id @default(cuid())
  moduleId    String
  module      CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  kind        CourseItemKind @default(PART)
  title       String
  position    Int            @default(0)
  completedAt DateTime?
  score       Int? // quiz only, 0 to 100
  notes       CourseNote[]

  @@index([moduleId, position])
  @@map("course_items")
}

/// One XP gain. We store every gain instead of a total, so nothing is ever counted twice
/// and the "XP journal" can show where each point comes from.
model XpEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     XpReason
  sourceId   String // id of the application, course or certification that earned the XP
  amount     Int
  label      String // shown in the journal, e.g. "Entretien technique · Qonto"
  occurredAt DateTime @default(now())

  // The same source can only earn the same reward once (no double counting).
  @@unique([reason, sourceId])
  @@index([userId, occurredAt])
  @@map("xp_events")
}

// =============================================================================
// HABITS & GOALS DOMAIN
// No XP here. Streaks are computed from check-ins (never stored), skipping
// rest days and pauses so a holiday never breaks a streak.
// =============================================================================

/// A habit, e.g. "1 h de SQL" on weekdays, or "Calisthenics" 3 times a week.
model Habit {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  activeDays   Int[] // ISO weekdays: 1 = Monday … 7 = Sunday
  timesPerWeek Int? // set for "X times a week" habits; null = every active day
  unit         String? // optional quantity unit, e.g. "min" or "pages"
  position     Int            @default(0)
  archivedAt   DateTime?
  checkIns     HabitCheckIn[]
  pauses       HabitPause[]
  goals        Goal[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@map("habits")
}

/// "Done" for one habit on one day, with an optional quantity (45 min, 30 pages).
model HabitCheckIn {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  quantity  Int?
  createdAt DateTime @default(now())

  // A habit can only be checked once per day.
  @@unique([habitId, date])
  @@map("habit_check_ins")
}

/// A pause (holidays, illness): freezes the streak. habitId null = every habit.
model HabitPause {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId, startDate])
  @@map("habit_pauses")
}

/// A goal with a numeric target ("20 h de SQL en octobre") and/or steps ("10 km : 5 étapes").
/// When linked to a habit, check-in quantities fill the progress automatically.
model Goal {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  target         Int?
  unit           String?
  manualProgress Int        @default(0)
  deadline       DateTime?  @db.Date
  habitId        String?
  habit          Habit?     @relation(fields: [habitId], references: [id], onDelete: SetNull)
  achievedAt     DateTime?
  steps          GoalStep[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId])
  @@map("goals")
}

model GoalStep {
  id       String    @id @default(cuid())
  goalId   String
  goal     Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title    String
  position Int
  doneAt   DateTime?

  @@index([goalId])
  @@map("goal_steps")
}

// =============================================================================
// LEISURE DOMAIN (video games only for now)
// =============================================================================

enum GameStatus {
  NOT_STARTED
  PLAYING
  PAUSED
  FINISHED
  DROPPED
}

/// A game, ordered inside its franchise by story order (e.g. Assassin's Creed by era).
model Game {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  franchise       String?
  storyOrder      Int? // position in the franchise's story, used for "next in franchise"
  setting         String? // in-game era, e.g. "1715"
  platform        String?
  status          GameStatus @default(NOT_STARTED)
  progressCurrent Int? // e.g. sequence 6…
  progressTotal   Int? // …of 13
  minutesPlayed   Int?
  coverUrl        String?
  startedAt       DateTime?
  finishedAt      DateTime?
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, franchise])
  @@index([userId, status])
  @@map("games")
}

// =============================================================================
// FINANCE DOMAIN
// Money is stored as an integer number of cents (never a float): 12,30 € = 1230.
// Expenses are negative, income is positive.
// =============================================================================

enum CategoryKind {
  EXPENSE
  INCOME
  SAVINGS
}

enum TransactionSource {
  MANUAL
  CSV_IMPORT
}

/// Reference data: the list of categories (seeded with a default list, then editable).
model FinanceCategory {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         CategoryKind
  position     Int           @default(0)
  archivedAt   DateTime?
  transactions Transaction[]

  @@unique([userId, name])
  @@map("finance_categories")
}

/// Usage data: one line of the bank statement, typed by hand or imported from a CSV.
model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime          @db.Date
  label       String
  amountCents Int // negative = expense, positive = income
  categoryId  String?
  category    FinanceCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  source      TransactionSource @default(MANUAL)
  importId    String?
  import      CsvImport?        @relation(fields: [importId], references: [id], onDelete: SetNull)
  importHash  String? // fingerprint of the CSV line, to skip duplicates on re-import
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, importHash])
  @@index([userId, date])
  @@map("transactions")
}

/// Trace of a CSV import. The file itself is never stored (GDPR): only the resulting transactions.
model CsvImport {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  rowCount      Int
  importedCount Int
  skippedCount  Int
  importedAt    DateTime      @default(now())
  transactions  Transaction[]

  @@index([userId, importedAt])
  @@map("csv_imports")
}

// =============================================================================
// TROPHIES (every domain, never XP)
// Trophy definitions (name, condition) live in code; the database only stores unlocks.
// =============================================================================

model TrophyUnlock {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trophyKey  String // e.g. "first-interview", "habit-streak-7"
  unlockedAt DateTime  @default(now())
  // Set once the toast has announced it (a trophy can unlock outside the current page).
  seenAt     DateTime?

  @@unique([userId, trophyKey])
  @@map("trophy_unlocks")
}

// =============================================================================
// PROFILE AND SKILLS
// Skill levels are never stored: a level is the last tier whose notions are all
// checked (see lib/skills.ts). SkillAssessment only keeps dated snapshots.
// =============================================================================

enum SkillCategory {
  WEB_FRONT
  BACKEND_DATA
  DATA_ENGINEERING
  SYSTEM_TOOLS
}

/// A language, framework or tool Alex learns, with 5 tiers of notions (5 = senior developer).
model Skill {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String
  name              String
  category          SkillCategory
  position          Int               @default(0)
  projectLabels     String[]          @map("projects") // legacy free labels (phase 2), replaced by the Project relation
  projects          Project[]
  tiers             SkillTier[]
  references        ReferenceEntry[]
  referenceSyncedAt DateTime? // last import or generation of the reference list
  assessments       SkillAssessment[]
  courses           Course[]
  certifications    Certification[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, slug])
  @@map("skills")
}

model SkillTier {
  id      String        @id @default(cuid())
  skillId String
  skill   Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level   Int // 1..5
  title   String // "Tableaux, objets et DOM"
  notions SkillNotion[]

  @@unique([skillId, level])
  @@map("skill_tiers")
}

/// A notion is "known" when checkedAt is set. The level is computed, never stored.
model SkillNotion {
  id               String           @id @default(cuid())
  tierId           String
  tier             SkillTier        @relation(fields: [tierId], references: [id], onDelete: Cascade)
  label            String
  position         Int              @default(0)
  checkedAt        DateTime?
  // Cheat sheet ("fiche mémo"), generated on first open, editable
  sheet            Json? // NotionSheet (lib/skills/schemas.ts)
  sheetGeneratedAt DateTime?
  sheetEditedAt    DateTime?
  notes            String? // "Mes notes", written by Alex
  references       ReferenceEntry[]

  @@index([tierId, position])
  @@map("skill_notions")
}

/// Snapshot saved after a guided re-evaluation, used for history charts.
model SkillAssessment {
  id         String   @id @default(cuid())
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      Int
  started    Boolean
  assessedAt DateTime @default(now())

  @@index([skillId, assessedAt])
  @@map("skill_assessments")
}

enum ToolStatus {
  DISCOVERED
  USING
  MASTERED
}

model Tool {
  id       String     @id @default(cuid())
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  status   ToolStatus @default(USING)
  position Int        @default(0)

  @@unique([userId, name])
  @@map("tools")
}

model ProfileInfo {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline      String // "Étudiant à 42 Paris · acarpent"
  targetRoles   String // "Full stack et/ou data engineer"
  currentSearch String // "Full stack uniquement"
  contracts     String
  zone          String
  availability  String
  githubUrl     String?

  @@map("profile_info")
}

model TimelineEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period    String // "2026 – en cours"
  title     String
  place     String?
  isCurrent Boolean  @default(false)
  position  Int      @default(0)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, position])
  @@map("timeline_entries")
}

// =============================================================================
// AI
// =============================================================================

/// One Gemini call. Only metadata: prompts and answers are never stored here.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature      String // "offer-extract" | "cv-import" | "cv-analysis" | "cv-adapt" | "cover-letter" | "mail-classify"
  model        String
  inputTokens  Int?
  outputTokens Int?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_usage")
}

// =============================================================================
// GITHUB PROJECTS
// A snapshot of each repository, refreshed on sync, plus Alex's own annotations.
// Code, READMEs and commits are always read live from GitHub and never stored.
// =============================================================================

enum ProjectCategory {
  SCHOOL_42
  PERSONAL
  TEAM
}

model Project {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId          BigInt // repository id from the GitHub API
  fullName          String // "Hushhhy/hushyboard"
  name              String
  description       String?
  url               String
  homepage          String?
  defaultBranch     String
  isPrivate         Boolean
  isFork            Boolean         @default(false)
  isArchived        Boolean         @default(false)
  isExternal        Boolean         @default(false) // public repo of someone else, added by URL
  topics            String[]
  languages         Json // [{ "name": "TypeScript", "percent": 82.1 }], sorted, in percent
  stars             Int             @default(0)
  pushedAt          DateTime?
  deletedOnGithubAt DateTime?
  syncedAt          DateTime
  // Alex's annotations, never overwritten by a sync
  category          ProjectCategory @default(PERSONAL)
  role              String? // "Mon rôle et ce que j'ai fait"
  pinned            Boolean         @default(false)
  hidden            Boolean         @default(false)
  featuredOnCv      Boolean         @default(false)
  skills            Skill[]
  courses           Course[]
  timelineEntries   TimelineEntry[]

  @@unique([userId, githubId])
  @@index([userId, pinned, pushedAt])
  @@map("projects")
}

// =============================================================================
// SKILL REFERENCE LISTS
// The complete list of a language (CSS properties, HTML tags, Git commands…).
// "Je connais" never changes the level: only the roadmap notions do.
// =============================================================================

enum ReferenceKind {
  ELEMENT // HTML tag
  ATTRIBUTE
  PROPERTY // CSS property
  AT_RULE // @media, @keyframes
  SELECTOR // pseudo-classes, pseudo-elements
  FUNCTION
  METHOD
  OBJECT // JS built-in object, DOM interface
  KEYWORD
  TYPE
  COMMAND // git, bash, docker, sql statements
  CLASS // Tailwind utility
  HOOK
  OTHER
}

enum ReferenceSource {
  MDN // @mdn/browser-compat-data
  AI
  MANUAL
}

/// One entry of a skill's reference list (a CSS property, an HTML tag, a Git command…).
model ReferenceEntry {
  id                 String          @id @default(cuid())
  skillId            String
  skill              Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  name               String // "justify-content", "<dialog>", "Array.prototype.map", "git rebase"
  kind               ReferenceKind
  group              String // French category label: "Mise en page", "Formulaires", "Tableaux"…
  summary            String? // one line, French
  details            Json? // ReferenceDetails (lib/skills/schemas.ts)
  detailsGeneratedAt DateTime?
  detailsEditedAt    DateTime?
  docUrl             String?
  source             ReferenceSource
  isCommon           Boolean         @default(false)
  isDeprecated       Boolean         @default(false)
  hidden             Boolean         @default(false)
  knownAt            DateTime? // "Je connais"
  favorite           Boolean         @default(false)
  notions            SkillNotion[]

  @@unique([skillId, kind, name])
  @@index([skillId, group])
  @@map("reference_entries")
}

model CoverLetter {
  id         String    @id @default(cuid())
  jobOfferId String    @unique
  jobOffer   JobOffer  @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)
  content    String
  model      String
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("cover_letters")
}

/// A site Alex follows for offers (« Sources suivies »). Offers match it by name.
model WatchSource {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  url      String?
  position Int     @default(0)

  @@unique([userId, name])
  @@map("watch_sources")
}

model WatchKeyword {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  label  String

  @@unique([userId, label])
  @@map("watch_keywords")
}

/// Gmail connection (separate from the GitHub sign-in). Only the refresh token is kept,
/// encrypted with AES-256-GCM (lib/crypto.ts). Mail content is never stored.
model GmailConnection {
  userId                String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  email                 String
  encryptedRefreshToken String
  scope                 String
  connectedAt           DateTime  @default(now())
  // Set when Google refuses the token (expired or revoked): « Connexion Gmail expirée ».
  lastErrorAt           DateTime?

  @@map("gmail_connections")
}

enum MailClassification {
  INTERVIEW
  REJECTION
  OTHER
}

enum MailDecision {
  ACCEPTED
  IGNORED
}

/// One Gmail message from a company Alex applied to, classified once. Content is never stored.
model MailMatch {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  applicationId  String?
  application    Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  classification MailClassification
  confidence     Float
  // One short French sentence shown in the banner.
  reason         String
  decision       MailDecision?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())

  @@unique([userId, gmailMessageId])
  @@map("mail_matches")
}

/// A sender Alex unsubscribed from: « Se désabonner » is hidden on its next mails.
model MailUnsubscribe {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Email address, lower case.
  sender         String
  // "one-click" | "mailto" | "link"
  method         String
  unsubscribedAt DateTime @default(now())

  @@unique([userId, sender])
  @@map("mail_unsubscribes")
}

/// « Veille automatique »: the Gmail label holding job-alert mails, and the last import.
model JobAlertSettings {
  userId         String    @id
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailLabelId   String?
  gmailLabelName String?
  lastSyncedAt   DateTime?
  // French message of the last failed import, shown until the next success.
  lastError      String?

  @@map("job_alert_settings")
}

/// A job-alert mail already read, so it is sent to Gemini only once. Its content is not stored.
model JobAlertMail {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String
  offersFound    Int
  processedAt    DateTime @default(now())

  @@unique([userId, gmailMessageId])
  @@map("job_alert_mails")
}
