# DATABASE (local Docker; Neon in production)
POSTGRES_USER=hushyboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hushyboard
DATABASE_URL="postgresql://hushyboard:change-me@localhost:5432/hushyboard"

# BETTER AUTH
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Numeric id of the only GitHub account allowed to sign in (https://api.github.com/users/<login>)
ALLOWED_GITHUB_ID=12345678


# GEMINI (free tier, https://aistudio.google.com, then Get API key)
GEMINI_API_KEY=your-gemini-api-key
# Comma-separated, tried in order. Main: complex tasks. Lite: simple tasks, and the fallback
# when every main model is out of quota.
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# GITHUB (projects): fine-grained token, read-only, All repositories, Metadata + Contents
GITHUB_TOKEN=github_pat_your-read-only-token

# GMAIL (Google Cloud OAuth client, Web application, see docs/claude-code/06-alex-actions.md)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# 32 random bytes in base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=base64-32-bytes
