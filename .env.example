# DATABASE (local Docker; Neon in production)
POSTGRES_USER=hushyboard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hushyboard
DATABASE_URL="postgresql://hushyboard:change-me@localhost:5432/hushyboard"

# BETTER AUTH
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-or-more-random-characters
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Numeric id of the only GitHub account allowed to sign in (https://api.github.com/users/<login>)
ALLOWED_GITHUB_ID=12345678


# GEMINI (free tier, https://aistudio.google.com, then Get API key)
GEMINI_API_KEY=your-gemini-api-key
# Main model (complex tasks) and lite model (simple tasks, fallback when the main one is out of quota)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite

# GITHUB (projects): fine-grained token, read-only, All repositories, Metadata + Contents
GITHUB_TOKEN=github_pat_your-read-only-token
